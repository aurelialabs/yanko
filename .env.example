# Browser-safe values
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only pepper used before persisting Magic Link rate-limit identifiers
AUTH_RATE_LIMIT_PEPPER=

# Server-only Supabase key
SUPABASE_SERVICE_ROLE_KEY=

# Product chat runtime stays local by default. For experience acceptance, set
# this to minimax-development in the Git-ignored .env.minimax-ai.local file and
# start with: npm run dev:minimax
# That mode sends the reply with MiniMax-M3 and, before the page refreshes,
# understands the same user message for memory, plan, and emotion.
AI_CHAT_RUNTIME_MODE=mock

# Completed user messages always enqueue metadata. These switches run the
# workers during Mock chat. MiniMax development chat runs them without
# flipping the switches, and still does nothing when the server key is absent.
MEMORY_EXTRACTION_ENABLED=false

# New active memories enqueue metadata only. Indexing remains fail-closed until
# a scheduler and an explicitly approved 1536-dimensional adapter are injected.
MEMORY_EMBEDDING_ENABLED=false

# Future completed user messages enqueue plan-task references only. The worker
# remains fail-closed until an event consumer injects an approved adapter.
PLAN_EXTRACTION_ENABLED=false

# Future completed user messages enqueue emotion-task references only. The
# exact-ID worker remains fail-closed until an event consumer injects an
# explicitly approved classifier adapter; it never scans chat history.
EMOTION_SIGNAL_ENABLED=false

# The follow-up delivery Worker is a separate default-off boundary. It cannot
# send, generate, or even claim a follow-up unless an approved composition
# root explicitly injects an exact-ID delivery implementation.
EMOTION_FOLLOWUP_DELIVERY_ENABLED=false

# This signed internal Route Handler is separate from the Worker switch. Keep
# both values unset/false until an approved scheduler and Adapter composition
# root exist. This secret must never use a NEXT_PUBLIC_ prefix.
EMOTION_SIGNAL_DISPATCH_ENABLED=false
EMOTION_SIGNAL_DISPATCH_SECRET=

# Development-stage model selection (not a production approval)
AI_GENERATION_PROVIDER=minimax
AI_GENERATION_MODEL=MiniMax-M3
AI_VALIDATION_PROVIDER=minimax
AI_VALIDATION_MODEL=MiniMax-M3
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# Candidate 1: server-only DashScope OpenAI-compatible evaluation settings
TAOKE_TAG_AI_ENABLED=true
TAOKE_TAG_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TAOKE_TAG_AI_API_KEY=
TAOKE_TAG_AI_MODEL=qwen-turbo
TAOKE_TAG_AI_TEMPERATURE=0.2
TAOKE_TAG_AI_TIMEOUT_MS=120000

# Candidate 2: server-only DeepSeek OpenAI-compatible evaluation settings
DEEPSEEK_AI_ENABLED=true
DEEPSEEK_AI_BASE_URL=https://api.deepseek.com
DEEPSEEK_AI_API_KEY=
DEEPSEEK_AI_MODEL=deepseek-v4-flash
DEEPSEEK_AI_TEMPERATURE=0.2
DEEPSEEK_AI_TIMEOUT_MS=120000

# Candidate 3 and development chat: server-only MiniMax settings
MINIMAX_AI_ENABLED=true
MINIMAX_AI_BASE_URL=https://api.minimax.cn/anthropic/v1/messages
MINIMAX_AI_API_KEY=
MINIMAX_AI_MODEL=MiniMax-M3
MINIMAX_AI_TEMPERATURE=0.2
MINIMAX_AI_TIMEOUT_MS=120000

# V0 embedding decision
OPENAI_API_KEY=
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small

# Background jobs and Web Push
TRIGGER_SECRET_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Monitoring and product analytics
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Encrypted AI debugging artifacts
AI_ARTIFACT_ENCRYPTION_KEY=
AI_ARTIFACT_ENCRYPTION_KEY_VERSION=
